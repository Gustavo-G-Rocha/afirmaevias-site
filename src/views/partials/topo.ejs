<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titulo %></title>
<meta name="description" content="<%= descricao %>">
<% if (typeof naoIndexar !== 'undefined' && naoIndexar) { %><meta name="robots" content="noindex, nofollow"><% } %>
<link rel="canonical" href="<%= siteUrl %><%= rotaAtual %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Afirma E-vias">
<meta property="og:title" content="<%= titulo %>">
<meta property="og:description" content="<%= descricao %>">
<meta property="og:image" content="<%= siteUrl %>/img/og.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta name="theme-color" content="#00233B">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="/img/favicon-32.png" sizes="32x32">
<link rel="icon" href="/img/favicon.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:url" content="<%= siteUrl %><%= rotaAtual %>">
<meta property="og:locale" content="pt_BR">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Afirma E-vias — engenharia viária">
<meta name="twitter:card" content="summary_large_image">
<%# A imagem do heroi vem de background-image no CSS: sem este preload o
    navegador so a descobre depois de baixar e interpretar a folha inteira,
    e ela e justamente o maior elemento da tela. %>
<% if (heroiPorRota[rotaAtual]) { %>
<link rel="preload" href="<%= heroiPorRota[rotaAtual] %>" as="image" fetchpriority="high">
<% } %>
<%# 400 e o texto corrido, 500 o titulo do heroi; 600 aparece na sobrancelha
    e no botao. Os tres estao acima da dobra em toda pagina. %>
<link rel="preload" href="/fontes/poppins-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fontes/poppins-500.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fontes/poppins-600.woff2" as="font" type="font/woff2" crossorigin>
<%# antes da folha de estilo e sem defer: o tema salvo vale ja na primeira pintura %>
<script src="<%= asset('/js/tema.js') %>"></script>
<link rel="stylesheet" href="<%= asset('/css/site.css') %>">
<script type="application/ld+json"><%- dadosEstruturados(rotaAtual, titulo, descricao) %></script>
</head>
<body data-rota="<%= rotaAtual %>">
<%# Icones do site, desenhados uma vez e referenciados com <use>. Ficam no
    proprio HTML porque a CSP nao deixa buscar SVG de fora. %>
<svg xmlns="http://www.w3.org/2000/svg" hidden aria-hidden="true">
  <symbol id="i-seta" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
  <symbol id="i-topo" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></symbol>
  <symbol id="i-conversa" viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8.5 9.5c0 3 2.5 5.5 5.5 5.5l1.2-1.2-1.8-1-.9.7a3.4 3.4 0 0 1-2-2l.7-.9-1-1.8z"/></symbol>
  <symbol id="i-telefone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></symbol>
  <symbol id="i-email" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></symbol>
  <symbol id="i-local" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-linkedin" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></symbol>
  <symbol id="i-instagram" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.4A4 4 0 1 1 12.6 8a4 4 0 0 1 3.4 3.4z"/><path d="M17.5 6.5h0"/></symbol>
  <symbol id="i-pausa" viewBox="0 0 24 24"><path d="M9 5v14M15 5v14"/></symbol>
  <symbol id="i-lua" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></symbol>
  <symbol id="i-sol" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></symbol>
</svg>
<a class="pular" href="#conteudo">Pular para o conteúdo</a>

<header class="cabecalho" id="cabecalho">
  <div class="cabecalho__interno">
    <a class="marca" href="/" aria-label="Afirma E-vias, página inicial">
      <img src="/img/logo-horizontal-claro.webp" alt="Afirma E-vias — engenharia viária" width="200" height="44">
    </a>

    <nav class="navegacao" id="navegacao" aria-label="Navegação principal">
      <% navegacao.forEach(function (item) { %>
        <a href="<%= item.href %>" class="navegacao__link <%= rotaAtual === item.href ? 'is-atual' : '' %>"<%= rotaAtual === item.href ? ' aria-current="page"' : '' %>><%= item.rotulo %></a>
      <% }); %>
      <a class="botao botao--claro navegacao__cta" href="https://wa.me/<%= empresa.whatsapp %>" target="_blank" rel="noopener">Falar agora</a>
      <%# so aparece no menu do celular, onde o rodape fica longe %>
      <div class="navegacao__extra">
        <a href="tel:+554131238550"><svg class="icone" aria-hidden="true"><use href="#i-telefone"/></svg><%= empresa.telefoneFixo %></a>
        <a href="mailto:<%= empresa.email %>"><svg class="icone" aria-hidden="true"><use href="#i-email"/></svg><%= empresa.email %></a>
      </div>
    </nav>

    <div class="cabecalho__acoes">
      <button type="button" class="tema-botao" id="tema-botao" aria-pressed="false" title="Usar tema escuro">
        <svg class="icone tema-botao__lua" aria-hidden="true"><use href="#i-lua"/></svg>
        <svg class="icone tema-botao__sol" aria-hidden="true"><use href="#i-sol"/></svg>
        <span class="sr">Tema escuro</span>
      </button>
      <button class="menu-botao" id="menu-botao" aria-expanded="false" aria-controls="navegacao">
        <span class="menu-botao__traco"></span>
        <span class="menu-botao__traco"></span>
        <span class="sr">Abrir menu</span>
      </button>
    </div>
  </div>
  <div class="cabecalho__progresso" id="progresso"></div>
</header>

<main id="conteudo">
