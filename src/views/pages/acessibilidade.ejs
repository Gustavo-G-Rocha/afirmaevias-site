<%- include('../partials/topo') %>

<section class="heroi heroi--pagina heroi--documento">
  <div class="heroi__faixa" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <div class="conteiner">
    <p class="sobrancelha"><%= acessibilidade.eyebrow %></p>
    <h1 class="titulo-display titulo-display--medio"><%= acessibilidade.titulo %></h1>
    <p class="documento__meta">Atualizada em <%= acessibilidade.atualizadoEm %></p>
  </div>
</section>

<section class="secao">
  <div class="conteiner documento documento--simples">
    <div class="documento__corpo">
      <p class="texto-grande texto-apoio"><%= acessibilidade.intro %></p>

      <section class="documento__secao">
        <h2 class="documento__titulo"><span class="documento__numero">01</span><%= acessibilidade.verificado.titulo %></h2>
        <ul class="lista-marcada">
          <% acessibilidade.verificado.lista.forEach(function (item) { %><li><%= item %></li><% }); %>
        </ul>
      </section>

      <section class="documento__secao">
        <h2 class="documento__titulo"><span class="documento__numero">02</span><%= acessibilidade.limites.titulo %></h2>
        <% acessibilidade.limites.paragrafos.forEach(function (p) { %><p><%= p %></p><% }); %>
      </section>

      <section class="documento__secao">
        <h2 class="documento__titulo"><span class="documento__numero">03</span><%= acessibilidade.contato.titulo %></h2>
        <p><%= acessibilidade.contato.texto %></p>
        <p>
          <a href="mailto:<%= empresa.email %>"><%= empresa.email %></a>
          · <a href="tel:+554131238550"><%= empresa.telefoneFixo %></a>
        </p>
      </section>

      <p class="documento__rodape">Sobre dados pessoais, veja a <a href="/politica-de-privacidade">Política de privacidade</a>.</p>
    </div>
  </div>
</section>

<%- include('../partials/rodape') %>
