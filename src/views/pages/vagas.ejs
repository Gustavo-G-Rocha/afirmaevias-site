<%- include('../partials/topo') %>

<section class="heroi heroi--pagina">
  <div class="heroi__faixa" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <div class="conteiner">
    <p class="sobrancelha"><%= vagas.eyebrow %></p>
    <h1 class="titulo-display"><%- vagas.titulo %></h1>
    <p class="heroi__chamada"><%= vagas.chamada %></p>
  </div>
</section>

<section class="secao">
  <div class="conteiner chamada__grade">
    <div>
      <p class="sobrancelha">Áreas</p>
      <h2 class="titulo-secao">Onde a gente costuma abrir vaga</h2>
      <ul class="lista-marcada">
        <% vagas.areas.forEach(function (area) { %><li><%= area %></li><% }); %>
      </ul>
      <p class="texto-apoio">Não achou a sua área? Manda mesmo assim. Guardamos currículos por 12 meses e você pode pedir a exclusão quando quiser pelo <a href="/portal-do-titular">Portal do titular</a>.</p>
    </div>

    <% if (enviado) { %>
      <div class="painel-sucesso painel-sucesso--claro" role="status">
        <p class="painel-sucesso__etiqueta">Currículo recebido</p>
        <p>Obrigado. Se o seu perfil combinar com uma vaga aberta, o RH entra em contato pelo e-mail que você cadastrou.</p>
        <a class="botao botao--escuro" href="/">Voltar para o início</a>
      </div>
    <% } else { %>
      <form class="formulario" method="post" action="/trabalhe-com-a-gente" enctype="multipart/form-data">
        <% if (erros && erros.length > 0) { %>
          <div class="alerta" role="alert">
            <% erros.forEach(function (mensagem) { %><p><%= mensagem %></p><% }); %>
          </div>
        <% } %>

        <label class="campo">
          <span class="campo__rotulo">Nome completo</span>
          <input type="text" name="nome" required maxlength="240" autocomplete="name"
                 value="<%= valores.nome || '' %>">
        </label>

        <label class="campo">
          <span class="campo__rotulo">E-mail</span>
          <input type="email" name="email" required maxlength="200" autocomplete="email"
                 inputmode="email" value="<%= valores.email || '' %>">
        </label>

        <label class="campo campo--arquivo">
          <span class="campo__rotulo">Currículo</span>
          <input type="file" name="curriculo" required
                 accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                 data-limite-mb="5" data-alvo="#arquivo-escolhido">
          <span class="campo__ajuda" id="arquivo-escolhido">PDF, DOC ou DOCX, até 5 MB.</span>
        </label>

        <label class="aceite">
          <input type="checkbox" name="consentimento" required>
          <span>Autorizo a Afirma E-vias a guardar meu currículo por 12 meses para processos seletivos, conforme a <a href="/politica-de-privacidade" target="_blank">Política de privacidade</a>.</span>
        </label>

        <p class="campo__ajuda">
          <strong>Menor de 18 anos?</strong> As vagas de estágio aceitam candidatos a partir de 16 anos.
          Nesse caso, envie o currículo com a ciência do seu responsável legal — o RH vai pedir a
          autorização por escrito antes de seguir com a candidatura, como prevê o art. 14 da LGPD.
        </p>

        <button type="submit" class="botao botao--verde botao--largo">Enviar currículo</button>

        <!-- o resto e opcional: fica recolhido para o formulario abrir com tres campos -->
        <details class="formulario__extra">
          <summary>Quer contar mais sobre você? (opcional)</summary>

          <label class="campo">
            <span class="campo__rotulo">Telefone</span>
            <input type="tel" name="telefone" maxlength="40" autocomplete="tel" inputmode="tel"
                   value="<%= valores.telefone || '' %>">
          </label>

          <label class="campo">
            <span class="campo__rotulo">Área de interesse</span>
            <select name="area">
              <option value="">Ainda não sei / outra área</option>
              <% vagas.areas.forEach(function (area) { %>
                <option value="<%= area %>" <%= valores.area === area ? 'selected' : '' %>><%= area %></option>
              <% }); %>
            </select>
          </label>

          <label class="campo">
            <span class="campo__rotulo">Recado para o RH</span>
            <textarea name="mensagem" rows="4" maxlength="5000"><%= valores.mensagem || '' %></textarea>
          </label>
        </details>
      </form>
    <% } %>
  </div>
</section>

<%- include('../partials/rodape') %>
