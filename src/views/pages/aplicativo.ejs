<%- include('../partials/topo') %>

<section class="heroi heroi--pagina heroi--escuro">
  <div class="heroi__faixa" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <div class="conteiner">
    <p class="sobrancelha sobrancelha--claro"><%= aplicativo.eyebrow %></p>
    <h1 class="titulo-display titulo-display--claro"><%- linhas(aplicativo.titulo) %></h1>
    <p class="heroi__chamada heroi__chamada--clara"><%= aplicativo.chamada %></p>
    <a class="botao botao--verde" href="/contato">Quero uma demonstração</a>
  </div>
</section>

<section class="secao">
  <div class="conteiner">
    <div class="cabeca-secao">
      <p class="sobrancelha" data-revelar>O que ele faz</p>
      <h2 class="titulo-secao" data-revelar>Quatro coisas que mudam na sua operação</h2>
    </div>
    <div class="grade-recursos">
      <% aplicativo.recursos.forEach(function (recurso, i) { %>
        <article class="recurso" data-revelar>
          <span class="recurso__numero" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span>
          <h3 class="recurso__titulo"><%= recurso.titulo %></h3>
          <p class="recurso__texto"><%= recurso.texto %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="secao secao--escura">
  <div class="conteiner grade-figura">
    <div>
      <p class="sobrancelha sobrancelha--claro" data-revelar>Na tela</p>
      <h2 class="titulo-secao titulo-secao--claro" data-revelar>O ensaio sai do papel <em>ainda no campo</em>.</h2>
      <p class="texto-claro" data-revelar>O técnico lança a leitura no celular, com ou sem sinal. Quando a conexão volta, o envio pendente sobe sozinho e o dado já chega ao controle com data, hora e responsável.</p>
    </div>
    <div class="vitrine" data-revelar="zoom">
      <% aplicativo.telas.filter(function (tela) { return tela.vitrine; }).sort(function (a, b) { return a.vitrine - b.vitrine; }).forEach(function (tela, i) { %>
        <%- include('../partials/celular', { tela: tela, paralaxe: [0.04, 0.09, 0.12][i] }) %>
      <% }); %>
    </div>
  </div>
</section>

<section class="secao secao--branca">
  <div class="conteiner">
    <div class="cabeca-secao">
      <p class="sobrancelha" data-revelar>Telas do aplicativo</p>
      <h2 class="titulo-secao" data-revelar>Do laboratório ao <em>canteiro de obra</em>.</h2>
    </div>
  </div>
  <%# carrossel de arrastar no celular, grade no desktop; usa a mesma barra de progresso da galeria da home %>
  <ul class="telas-app" role="list" data-galeria>
    <% aplicativo.telas.forEach(function (tela) { %>
      <li class="telas-app__item" data-revelar>
        <%- include('../partials/celular', { tela: tela }) %>
        <p class="telas-app__legenda"><span class="telas-app__app"><%= tela.app %></span><%= tela.titulo %></p>
      </li>
    <% }); %>
  </ul>
  <div class="galeria__progresso" aria-hidden="true"><span></span></div>
</section>

<section class="secao secao--clara">
  <div class="conteiner faixa-fecho" data-revelar>
    <p class="faixa-fecho__texto"><%= aplicativo.fecho %></p>
    <a class="botao botao--escuro" href="/servicos#supervisao">Ver como usamos na obra</a>
  </div>
</section>

<%- include('../partials/chamada-contato') %>
<%- include('../partials/rodape') %>
