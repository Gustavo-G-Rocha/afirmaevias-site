<%- include('../partials/topo') %>

<section class="heroi heroi--inicio heroi--imagem">
  <div class="heroi__faixa" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <div class="conteiner heroi__grade">
    <div class="heroi__texto">
      <p class="sobrancelha"><%= home.eyebrow %></p>
      <h1 class="titulo-display"><%- linhas(home.titulo) %></h1>
      <p class="heroi__chamada"><%= home.chamada %></p>
      <p class="heroi__apoio"><%= home.apoio %></p>
      <div class="heroi__acoes">
        <a class="botao botao--verde" href="/servicos">Ver os serviços</a>
        <a class="botao botao--fantasma" href="/afirma-evias">Conhecer a trajetória</a>
      </div>
    </div>
    <div class="heroi__aparte">
      <p class="heroi__aparte-rotulo">Onde já estivemos</p>
      <p class="heroi__aparte-numero"><span class="sr">50.000</span><span aria-hidden="true" data-contar="50000">50.000</span><span class="heroi__aparte-unidade">km</span></p>
      <p class="heroi__aparte-texto">de obras fiscalizadas em rodovias e vias urbanas por todo o Brasil.</p>
    </div>
  </div>
</section>

<section class="secao indicadores" aria-label="A Afirma E-vias em números">
  <div class="conteiner">
    <div class="grade-indicadores">
      <% indicadores.forEach(function (indicador) { %>
        <div class="indicador" data-revelar>
          <p class="indicador__valor">+<span class="sr"><%= indicador.valor %></span><span aria-hidden="true" data-contar="<%= indicador.valor.replace(/\./g, '') %>"><%= indicador.valor %></span><span class="indicador__unidade"><%= indicador.unidade %></span></p>
          <p class="indicador__rotulo"><%= indicador.rotulo %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="secao">
  <div class="conteiner">
    <div class="cabeca-secao">
      <p class="sobrancelha" data-revelar>Serviços</p>
      <h2 class="titulo-secao" data-revelar>Serviços que transformam o seu projeto viário em <em>realidade</em>.</h2>
    </div>

    <div class="grade-cartoes">
      <% home.servicosResumo.forEach(function (servico, i) { %>
        <a class="cartao" href="<%= servico.href %>" data-revelar>
          <span class="cartao__topo" aria-hidden="true">
            <span class="cartao__numero"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="cartao__marca"></span>
          </span>
          <h3 class="cartao__titulo"><%= servico.titulo %></h3>
          <p class="cartao__texto"><%= servico.texto %></p>
          <span class="cartao__mais" aria-hidden="true">Saiba mais <svg class="icone"><use href="#i-seta"/></svg></span>
        </a>
      <% }); %>
    </div>

    <a class="botao botao--escuro" href="/servicos" data-revelar>Saiba mais sobre nossos serviços</a>
  </div>
</section>

<section class="secao secao--escura destaque-app">
  <div class="conteiner destaque-app__grade">
    <div>
      <p class="sobrancelha sobrancelha--claro" data-revelar>Aplicativo Afirma E-vias</p>
      <h2 class="titulo-secao titulo-secao--claro" data-revelar>Tecnologia avançada para quem não abre mão de <em>qualidade, inovação e segurança.</em></h2>
      <p class="texto-claro" data-revelar>Gestão da obra em tempo real, com ensaios georreferenciados, alertas de não conformidade e dashboards analíticos.</p>
      <ul class="lista-marcada lista-marcada--clara">
        <li data-revelar="esquerda">Ensaios registrados no ponto de aplicação</li>
        <li data-revelar="esquerda">Alerta imediato de não conformidade</li>
        <li data-revelar="esquerda">Cálculo automático de dosagem CBUQ e MRAF</li>
        <li data-revelar="esquerda">Exportação de relatórios em PDF e CSV</li>
      </ul>
      <a class="botao botao--verde" href="/aplicativo" data-revelar>Descubra as funcionalidades</a>
    </div>
    <div class="vitrine" data-revelar="zoom">
      <% telasApp.filter(function (tela) { return tela.vitrine; }).sort(function (a, b) { return a.vitrine - b.vitrine; }).forEach(function (tela, i) { %>
        <%- include('../partials/celular', { tela: tela, paralaxe: [0.04, 0.09, 0.12][i] }) %>
      <% }); %>
    </div>
  </div>
</section>

<section class="secao secao--branca">
  <div class="conteiner">
    <div class="cabeca-secao">
      <p class="sobrancelha" data-revelar>Do campo à bancada</p>
      <h2 class="titulo-secao" data-revelar>Da pista ao laboratório, <em>com método e registro</em>.</h2>
    </div>
  </div>
  <ul class="galeria" role="list" data-galeria>
    <% home.galeria.forEach(function (foto) { %>
      <li class="galeria__item" data-revelar>
        <figure class="galeria__figura">
          <img src="/img/<%= foto.arquivo %>" width="<%= foto.largura %>" height="<%= foto.altura %>"
               loading="lazy" decoding="async" data-paralaxe="0.05" alt="<%= foto.alt %>">
          <figcaption><span class="galeria__rotulo"><%= foto.rotulo %></span><%= foto.legenda %></figcaption>
        </figure>
      </li>
    <% }); %>
  </ul>
  <div class="galeria__progresso" aria-hidden="true"><span></span></div>
</section>

<section class="secao secao--clara">
  <div class="conteiner">
    <div class="cabeca-secao">
      <p class="sobrancelha" data-revelar>Quem confia</p>
      <h2 class="titulo-secao" data-revelar>Concessionárias, órgãos públicos e <em>indústria</em>.</h2>
    </div>
  </div>

  <%# A lista vai em duas faixas que andam em sentidos opostos. Cada faixa
      repete as marcas numa copia aria-hidden para o laco nao ter emenda: o
      leitor de tela ouve cada cliente uma vez so. %>
  <% var metade = Math.ceil(clientes.length / 2); %>
  <div class="clientes-faixa" id="clientes-faixa" data-revelar>
    <% [clientes.slice(0, metade), clientes.slice(metade)].forEach(function (grupo, n) { %>
      <div class="clientes-faixa__trilho<%= n === 1 ? ' clientes-faixa__trilho--reverso' : '' %>">
        <ul class="clientes" role="list">
          <% grupo.forEach(function (cliente) { %>
            <li class="clientes__item">
              <img src="/img/clientes/<%= cliente.arquivo %>" height="96" loading="lazy" decoding="async" alt="<%= cliente.nome %>">
            </li>
          <% }); %>
        </ul>
        <ul class="clientes" aria-hidden="true">
          <% grupo.forEach(function (cliente) { %>
            <li class="clientes__item">
              <img src="/img/clientes/<%= cliente.arquivo %>" height="96" loading="lazy" decoding="async" alt="">
            </li>
          <% }); %>
        </ul>
      </div>
    <% }); %>
  </div>

  <div class="conteiner clientes-rodape">
    <p class="nota-marcas"><%= notaClientes %></p>
    <button type="button" class="clientes-pausa" aria-controls="clientes-faixa" aria-pressed="false" data-pausar>
      <svg class="icone" aria-hidden="true"><use href="#i-pausa"/></svg><span>Pausar animação</span>
    </button>
  </div>
</section>

<%- include('../partials/chamada-contato') %>
<%- include('../partials/rodape') %>
