<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Entrar · Painel Afirma E-vias</title>
<link rel="icon" href="/img/favicon.png" type="image/png">
<link rel="preload" href="/fontes/poppins-300.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="entrada">
  <div class="entrada__faixa" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>

  <main class="entrada__caixa">
    <img src="/img/logo-vertical-claro.png" alt="Afirma E-vias" width="150" height="75">
    <h1 class="entrada__titulo">Painel do site</h1>
    <p class="entrada__texto">Acesso restrito à equipe. Toda ação aqui fica registrada na trilha de auditoria.</p>

    <form method="post" action="/admin/login" class="formulario-admin">
      <% if (aviso) { %><p class="alerta-admin alerta-admin--ok" role="status"><%= aviso %></p><% } %>
      <% if (erro) { %><p class="alerta-admin" role="alert"><%= erro %></p><% } %>

      <label class="campo-admin">
        <span>E-mail</span>
        <input type="email" name="email" required autocomplete="username" value="<%= email %>" autofocus>
      </label>

      <label class="campo-admin">
        <span>Senha</span>
        <input type="password" name="senha" required autocomplete="current-password">
      </label>

      <button type="submit" class="botao-admin botao-admin--verde">Entrar</button>
    </form>
  </main>
</body>
</html>
