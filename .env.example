# Railway injeta DATABASE_URL automaticamente ao ligar o plugin Postgres
DATABASE_URL=postgresql://postgres:senha@localhost:5432/afirmaevias
PORT=3000
NODE_ENV=development

# Segredo usado para assinar o cookie de sessao do /admin (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres

# Admin inicial criado pela migration (so na primeira execucao)
ADMIN_EMAIL=admin@afirmaevias.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador

# Dominio publico, usado em canonical/OG
SITE_URL=https://www.afirmaevias.com.br
