# Obrigatoria. No Railway o plugin Postgres injeta esta variavel sozinho.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/afirmaevias

# Admin inicial criado pela migration (so na primeira execucao)
ADMIN_EMAIL=admin@afirmaevias.com.br
ADMIN_PASSWORD=troque-esta-senha

# --- Opcionais: todas tem valor padrao, so configure se quiser mudar ---
# PORT=3000
# NODE_ENV=development            # no Railway e detectado automaticamente
# SESSION_SECRET=                 # gere com: openssl rand -hex 32
#                                 # sem ela o segredo e sorteado a cada boot e
#                                 # o painel desloga a cada redeploy
# ADMIN_NOME=Administrador
# SITE_URL=https://www.afirmaevias.com.br

# --- Avisos por e-mail (src/notificacoes.ts) ---
# Sem RESEND_API_KEY o envio e ignorado e os registros ficam so no /admin
# RESEND_API_KEY=
# EMAIL_REMETENTE=site@afirmaevias.com.br
# EMAIL_CONTATO=comercial@afirmaevias.com.br
# EMAIL_RH=comercial@afirmaevias.com.br
# EMAIL_COMPLIANCE=comercial@afirmaevias.com.br
# EMAIL_ENCARREGADO=privacidade@afirmaevias.com.br
